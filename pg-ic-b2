                    <span style="font-size: 24px;">⌬</span> Online Examination
                </h2>
                
                <label><b>Roll Number / Register Number:</b></label>
                <input type="text" id="rollNo" placeholder="Enter your Roll Number">
                
                <label><b>Batch Passcode:</b></label>
                <input type="password" id="passcode" placeholder="Enter Passcode">
                
                <button onclick="startLogin()">Start Exam</button>
            </div>
