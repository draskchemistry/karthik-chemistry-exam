<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chemistry Exam Portal | Dr. A.S. KARTHIK</title>
    <style>
        :root {
            --primary: #0a2342;
            --secondary: #f0a500;
            --bg-color: #e8f0f6;
            --text: #2c3e50;
        }
        * { box-sizing: border-box; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        
        /* Chemistry Benzene Ring / Honeycomb Pattern Background */
        body { 
            background-color: var(--bg-color); 
            background-image: url("data:image/svg+xml,%3Csvg width='60' height='103.9' viewBox='0 0 60 103.9' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' stroke='%230a2342' stroke-width='1.5' stroke-opacity='0.08'%3E%3Cpolygon points='30,103.9 0,86.6 0,51.9 30,34.6 60,51.9 60,86.6'/%3E%3Cpolygon points='30,51.9 0,34.6 0,0 30,-17.3 60,0 60,34.6'/%3E%3C/g%3E%3C/svg%3E");
            color: var(--text); margin: 0; padding: 0; 
        }
        
        /* Enhanced Header */
        .header {
            background: linear-gradient(135deg, #0a2342 0%, #17406d 100%);
            color: white; padding: 25px 20px;
            display: flex; justify-content: space-between; align-items: center;
            border-bottom: 5px solid var(--secondary); box-shadow: 0 6px 12px rgba(0,0,0,0.15);
            position: relative; overflow: hidden;
        }
        .header::before {
            content: '⌬'; position: absolute; font-size: 150px; color: rgba(255,255,255,0.05);
            right: 15%; top: -40px; transform: rotate(15deg);
        }
        .header::after {
            content: '⚗️'; position: absolute; font-size: 100px; color: rgba(255,255,255,0.05);
            left: 5%; top: -10px; transform: rotate(-15deg);
        }
        .college-info { text-align: center; flex-grow: 1; z-index: 1; }
        .college-info h1 { margin: 0; font-size: 26px; color: #fff; letter-spacing: 1px; text-shadow: 2px 2px 4px rgba(0,0,0,0.5); }
        .college-info h2 { margin: 10px 0 5px; font-size: 18px; color: var(--secondary); }
        .college-info p { margin: 5px 0 0; font-size: 16px; font-weight: bold; color: #d0e1f9; }
        
        .emblem {
            background: linear-gradient(135deg, #ffca28, #f57f17); color: #000;
            width: 85px; height: 85px; border-radius: 50%; display: flex; align-items: center; 
            justify-content: center; text-align: center; font-weight: 900; font-size: 13px;
            border: 3px solid white; box-shadow: 0 0 15px rgba(240,165,0,0.6); z-index: 1;
        }

        /* Glassmorphism Container */
        .container { 
            max-width: 1000px; margin: 30px auto; padding: 30px; 
            background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(5px);
            border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.1); 
            border: 1px solid rgba(255,255,255,0.2);
        }
        .section { display: none; }
        .active { display: block; animation: fadeIn 0.5s; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        
        .login-card { max-width: 420px; margin: 0 auto; background: #fff; padding: 30px; box-shadow: 0 8px 20px rgba(0,0,0,0.08); border-radius: 12px; border-top: 5px solid var(--primary); }
        
        input[type="text"], input[type="password"] { width: 100%; padding: 14px; margin: 10px 0 20px; border: 1px solid #ccc; border-radius: 6px; font-size: 16px; transition: 0.3s; }
        input[type="text"]:focus, input[type="password"]:focus { border-color: var(--secondary); outline: none; box-shadow: 0 0 8px rgba(240,165,0,0.3); }
        
        button { background-color: var(--primary); color: white; border: none; padding: 14px 20px; font-size: 16px; font-weight: bold; border-radius: 6px; cursor: pointer; transition: 0.3s; margin-top: 10px; width: 100%; letter-spacing: 0.5px; }
        button:hover { background-color: #06182e; transform: translateY(-2px); box-shadow: 0 4px 10px rgba(0,0,0,0.2); }
        .btn-secondary { background-color: var(--secondary); color: #000; }
        .btn-secondary:hover { background-color: #d69300; }
        
        .exam-header { display: flex; justify-content: space-between; background: #f8f9fa; padding: 15px; border-radius: 8px; margin-bottom: 25px; font-weight: bold; border-left: 5px solid var(--primary); }
        .timer { color: #d32f2f; font-size: 18px; }
        .question-box { font-size: 19px; line-height: 1.6; margin-bottom: 25px; color: #1a252f; }
        .options-box { display: flex; flex-direction: column; gap: 12px; }
        .option-label { background: #fff; padding: 16px; border: 2px solid #e0e0e0; border-radius: 8px; cursor: pointer; display: flex; align-items: center; gap: 15px; font-size: 17px; transition: 0.2s; }
        .option-label:hover { border-color: var(--secondary); background: #fffdf5; }
        input[type="radio"] { transform: scale(1.3); accent-color: var(--primary); }
        .nav-buttons { display: flex; justify-content: space-between; margin-top: 30px; gap: 15px; }
        .nav-buttons button { width: auto; padding: 12px 30px; }
        
        .result-box { margin-bottom: 20px; padding: 20px; border-radius: 8px; border: 1px solid #e0e0e0; background: #fff; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
        .correct-ans { color: #2e7d32; font-weight: bold; }
        .wrong-ans { color: #c62828; font-weight: bold; }
        .exp { background: #f0f4f8; padding: 12px; border-left: 4px solid var(--primary); margin-top: 12px; font-size: 15px; border-radius: 0 4px 4px 0;}
        .lang-toggle { position: fixed; bottom: 20px; right: 20px; border-radius: 50px; box-shadow: 0 4px 10px rgba(0,0,0,0.3); z-index: 1000; width: auto; }
    </style>
</head>
