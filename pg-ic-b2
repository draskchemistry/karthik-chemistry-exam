                <button class="btn-secondary" style="width: auto; padding: 10px 20px;" onclick="switchView('admin-login-section')">Admin Login</button>
            </div>
        </div>

        <!-- ADMIN LOGIN SECTION -->
        <div id="admin-login-section" class="section">
            <div class="login-card">
                <h2 style="text-align: center; color: var(--primary); margin-top: 0;">Professor Admin Portal</h2>
                <label><b>Admin Password:</b></label>
                <input type="password" id="adminPass" placeholder="Enter Admin Password">
                
                <button onclick="verifyAdmin()">Login</button>
                <button style="background: #e0e0e0; color: #333;" onclick="switchView('login-section')">Back to Home</button>
            </div>
        </div>

        <!-- ADMIN DASHBOARD -->
        <div id="admin-dashboard" class="section">
            <h2>Welcome Dr. A.S. KARTHIK (Admin Dashboard)</h2>
            <button onclick="switchView('login-section')" style="float: right; background: #c62828; width: auto;">Logout</button>
            
            <div style="background: #fff; padding: 20px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); margin-bottom: 20px;">
                <h3 style="margin-top: 0;">1. Passcode Details</h3>
                <p><b>Batch 1:</b> BSCIIIB1</p>
            </div>

            <div style="background: #fff; padding: 20px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                <h3 style="margin-top: 0;">2. Reset Student Roll Number</h3>
                <p>If a student's test was interrupted, enter their roll number to allow them to write again.</p>
                <input type="text" id="resetRollNo" placeholder="Enter Roll Number" style="width: 300px; display: inline-block; margin-right: 10px;">
                <button onclick="resetStudent()" style="width: auto; display: inline-block;">Reset Access</button>
            </div>
        </div>

        <!-- EXAM SECTION -->
        <div id="exam-section" class="section">
            <div class="exam-header">
                <span id="student-info-display">Roll No: </span>
                <span id="batch-display">Batch: </span>
                <span class="timer">Time Left: <span id="time">40:00</span></span>
            </div>
            
            <div class="question-box" id="question-text"></div>
            <div class="options-box" id="options-container"></div>
            
            <div class="nav-buttons">
                <button onclick="prevQuestion()" id="btn-prev">Previous</button>
                <button class="btn-secondary" onclick="submitExam()" id="btn-submit" style="display:none; width: auto;">Submit Exam</button>
                <button onclick="nextQuestion()" id="btn-next">Next</button>
            </div>
        </div>

        <!-- RESULT SECTION -->
        <div id="result-section" class="section">
            <div style="text-align: center; margin-bottom: 30px;">
                <h2 style="font-size: 28px; color: var(--primary);">Exam Completed!</h2>
                <h3 id="score-display" style="font-size: 24px; color: #2e7d32; background: #e8f5e9; padding: 15px; border-radius: 8px; display: inline-block;"></h3>
                <br>
                <button onclick="switchView('login-section')" style="width: auto; margin-top: 20px;">Back to Home</button>
            </div>
            <div id="review-container"></div>
        </div>
    </div>

