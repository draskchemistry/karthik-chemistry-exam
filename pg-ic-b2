    <header class="header">
        <div></div>
        <div class="college-info">
            <h1>ARIGNAR ANNA GOVT ARTS COLLEGE, ATTUR - 636 121</h1>
            <h2>PG DEPARTMENT OF CHEMISTRY</h2>
            <h2>Class: B.Sc. Chemistry 3rd Year</h2>
