                qTA: "[NiCl<sub>4</sub>]<sup>2-</sup> போன்ற தளசதுர அணைவு அதிகப்படியான NH<sub>3</sub> உடன் வினைபுரியும் போது எதிர்பார்க்கப்படும் முடிவு என்ன?",
                optEN: ["Formation of [Ni(NH<sub>3</sub>)<sub>4</sub>]<sup>2+</sup>", "Formation of [NiCl<sub>6</sub>]<sup>2-</sup>", "Formation of [Ni(NH<sub>3</sub>)<sub>6</sub>]<sup>2+</sup>", "No reaction"],
                optTA: ["[Ni(NH<sub>3</sub>)<sub>4</sub>]<sup>2+</sup> உருவாதல்", "[NiCl<sub>6</sub>]<sup>2-</sup> உருவாதல்", "[Ni(NH<sub>3</sub>)<sub>6</sub>]<sup>2+</sup> உருவாதல்", "மாற்றமில்லை"],
                ans: 2,
                expEN: "With excess ammonia, Ni<sup>2+</sup> typically expands its coordination to form octahedral [Ni(NH<sub>3</sub>)<sub>6</sub>]<sup>2+</sup>.",
                expTA: "அதிகப்படியான அம்மோனியாவுடன் Ni<sup>2+</sup> எண்முகி அணைவான [Ni(NH<sub>3</sub>)<sub>6</sub>]<sup>2+</sup> ஐ உருவாக்குகிறது."
            },
            {
                id: 27, batch: 1,
                qEN: "Which of the following is true about the ligand CN<sup>-</sup>?",
                qTA: "CN<sup>-</sup> ஈனி பற்றிய பின்வரும் கூற்றுகளில் எது உண்மையானது?",
                optEN: ["It is a weak field ligand.", "It can only act as a monodentate ligand.", "It forms a strong field complex with Fe<sup>2+</sup>.", "It is a bidentate ligand."],
                optTA: ["இது ஒரு மெல்லிய புல ஈனி.", "இது ஒற்றை ஈனியாக மட்டுமே செயல்படும்.", "இது Fe<sup>2+</sup> உடன் வலிமையான புல அணைவை உருவாக்குகிறது.", "இது இருமுனை ஈனி."],
                ans: 2,
                expEN: "Cyanide is a strong field ligand, commonly forming low-spin complexes with metals like Fe<sup>2+</sup>.",
                expTA: "சயனைடு ஒரு வலிமையான புல ஈனியாகும்."
            },
            {
                id: 28, batch: 1,
                qEN: "What is the geometry of [NiCl<sub>4</sub>]<sup>2-</sup>?",
                qTA: "[NiCl<sub>4</sub>]<sup>2-</sup> இன் வடிவம் என்ன?",
                optEN: ["Tetrahedral", "Square planar", "Octahedral", "Linear"],
                optTA: ["நான்முகி", "தளசதுரம்", "எண்முகி", "நேர்கோட்டு அமைப்பு"],
                ans: 0,
                expEN: "Chloride is a weak field ligand, resulting in a high-spin tetrahedral geometry for Ni<sup>2+</sup> (d<sup>8</sup>).",
                expTA: "குளோரைடு மெல்லிய ஈனி என்பதால் இது நான்முகி அமைப்பை உருவாக்குகிறது."
            },
            {
                id: 29, batch: 1,
                qEN: "What happens when [CuCl<sub>4</sub>]<sup>2-</sup> reacts with water?",
                qTA: "[CuCl<sub>4</sub>]<sup>2-</sup> நீருடன் வினைபுரியும் போது என்ன நடக்கிறது?",
                optEN: ["No change", "Formation of [Cu(H<sub>2</sub>O)<sub>4</sub>]<sup>2+</sup>", "Formation of Cu<sub>2</sub>Cl<sub>6</sub>", "Formation of CuCl<sub>2</sub>"],
                optTA: ["மாற்றமில்லை", "[Cu(H<sub>2</sub>O)<sub>4</sub>]<sup>2+</sup> உருவாதல்", "Cu<sub>2</sub>Cl<sub>6</sub> உருவாதல்", "CuCl<sub>2</sub> உருவாதல்"],
                ans: 1,
                expEN: "Water replaces the chloride ligands, forming the blue aquo complex.",
                expTA: "நீர் குளோரைடு ஈனிகளை பதிலீடு செய்கிறது."
            },
            {
                id: 30, batch: 1,
                qEN: "What is the product when a cobalt(III) complex [Co(NH<sub>3</sub>)<sub>5</sub>Cl]<sup>2+</sup> reacts with chloride ion?",
                qTA: "[Co(NH<sub>3</sub>)<sub>5</sub>Cl]<sup>2+</sup> குளோரைடு அயனியுடன் வினைபுரியும் போது கிடைக்கும் விளைபொருள் என்ன?",
                optEN: ["[Co(NH<sub>3</sub>)<sub>5</sub>Cl<sub>2</sub>]<sup>+</sup>", "[Co(NH<sub>3</sub>)<sub>5</sub>Cl<sub>3</sub>]<sup>+</sup>", "[Co(NH<sub>3</sub>)<sub>6</sub>]<sup>3+</sup>", "[CoCl<sub>6</sub>]<sup>3-</sup>"],
                optTA: ["[Co(NH<sub>3</sub>)<sub>5</sub>Cl<sub>2</sub>]<sup>+</sup>", "[Co(NH<sub>3</sub>)<sub>5</sub>Cl<sub>3</sub>]<sup>+</sup>", "[Co(NH<sub>3</sub>)<sub>6</sub>]<sup>3+</sup>", "[CoCl<sub>6</sub>]<sup>3-</sup>"],
                ans: 0,
                expEN: "A likely substitution under specific conditions replaces an ammonia with a chloride.",
                expTA: "இந்த வினையில் [Co(NH<sub>3</sub>)<sub>5</sub>Cl<sub>2</sub>]<sup>+</sup> உருவாக வாய்ப்புள்ளது."
            }
        ];

        const passcodes = { "BSCIIIB1": 1 };
        const ADMIN_PASS = "Karthik@123";
        let currentBatch = 0, currentQIndex = 0, selectedAnswers = {}, language = 'en', timerInterval, studentRollNo = "";
        let examQuestions = [];

        function switchView(viewId) {
            document.querySelectorAll('.section').forEach(sec => sec.classList.remove('active'));
            document.getElementById(viewId).classList.add('active');
            if(timerInterval) clearInterval(timerInterval);
        }

        function toggleLanguage() {
            language = (language === 'en') ? 'ta' : 'en';
            if (document.getElementById('exam-section').classList.contains('active')) renderQuestion();
        }

        function startLogin() {
            let roll = document.getElementById('rollNo').value.trim().toUpperCase();
            let pass = document.getElementById('passcode').value.trim().toUpperCase();
            if (!roll || !pass) return alert("Please enter both Roll Number and Passcode.");
            if (!passcodes[pass]) return alert("Invalid Passcode!");

            currentBatch = passcodes[pass];
            studentRollNo = roll;

            let completeKey = `exam_${roll}_batch${currentBatch}_complete`;
            if(localStorage.getItem(completeKey)) return alert("You have already completed this exam batch.");

            let startTimeKey = `exam_${roll}_batch${currentBatch}_start`;
            let savedTime = localStorage.getItem(startTimeKey);
            let now = Date.now();
            if (savedTime && (now - parseInt(savedTime) > 8 * 60 * 60 * 1000)) return alert("Your 8-hour access window has expired.");
            if (!savedTime) localStorage.setItem(startTimeKey, now);

            examQuestions = defaultQuestions.filter(q => q.batch === currentBatch);
            if(examQuestions.length === 0) return alert("No questions found for this batch yet.");

            document.getElementById('student-info-display').innerText = "Roll No: " + roll;
            document.getElementById('batch-display').innerText = "Batch: " + currentBatch;

            switchView('exam-section');
            startTimer(40 * 60);
            currentQIndex = 0; selectedAnswers = {}; renderQuestion();
        }

        function startTimer(duration) {
            let timer = duration;
            document.getElementById('time').innerText = "40:00";
            timerInterval = setInterval(function () {
                let minutes = parseInt(timer / 60, 10);
                let seconds = parseInt(timer % 60, 10);
                document.getElementById('time').textContent = (minutes < 10 ? "0" + minutes : minutes) + ":" + (seconds < 10 ? "0" + seconds : seconds);
                if (--timer < 0) { clearInterval(timerInterval); alert("Time is up! Auto-submitting exam."); submitExam(); }
            }, 1000);
        }

        function renderQuestion() {
            let q = examQuestions[currentQIndex];
            let qText = language === 'en' ? q.qEN : q.qTA;
            let opts = language === 'en' ? q.optEN : q.optTA;
            
            document.getElementById('question-text').innerHTML = `<b>Q${currentQIndex + 1}:</b> ${qText}`;
            document.getElementById('options-container').innerHTML = opts.map((opt, i) => `
                <label class="option-label">
                    <input type="radio" name="qopt" value="${i}" ${selectedAnswers[currentQIndex] === i ? "checked" : ""} onchange="selectedAnswers[currentQIndex]=${i}">
                    <span>${opt}</span>
                </label>
            `).join('');

            document.getElementById('btn-prev').disabled = currentQIndex === 0;
            document.getElementById('btn-next').style.display = currentQIndex === examQuestions.length - 1 ? 'none' : 'block';
            document.getElementById('btn-submit').style.display = currentQIndex === examQuestions.length - 1 ? 'block' : 'none';
        }

        function prevQuestion() { if(currentQIndex > 0) { currentQIndex--; renderQuestion(); } }
        function nextQuestion() { if(currentQIndex < examQuestions.length - 1) { currentQIndex++; renderQuestion(); } }

        function submitExam() {
            clearInterval(timerInterval);
            let score = 0, reviewHTML = "";

            examQuestions.forEach((q, idx) => {
                let userAns = selectedAnswers[idx];
                let isCorrect = (userAns === q.ans);
                if(isCorrect) score++;

                let opts = language === 'en' ? q.optEN : q.optTA;
                reviewHTML += `<div class="result-box">
                    <p style="font-size: 18px;"><b>Q${idx+1}:</b> ${language === 'en' ? q.qEN : q.qTA}</p>
                    <p>Your Answer: <span class="${isCorrect ? 'correct-ans' : 'wrong-ans'}">${userAns !== undefined ? opts[userAns] : 'Not Attempted'}</span></p>
                    ${!isCorrect ? `<p>Correct Answer: <span class="correct-ans">${opts[q.ans]}</span></p>` : ''}
                    <div class="exp"><b>Explanation:</b> ${language === 'en' ? q.expEN : q.expTA}</div>
                </div>`;
            });

            document.getElementById('score-display').innerText = `Your Score: ${score} / ${examQuestions.length}`;
            document.getElementById('review-container').innerHTML = reviewHTML;
            localStorage.setItem(`exam_${studentRollNo}_batch${currentBatch}_complete`, "true");
            switchView('result-section');
        }

        function verifyAdmin() {
            if(document.getElementById('adminPass').value === ADMIN_PASS) {
                document.getElementById('adminPass').value = ""; switchView('admin-dashboard');
            } else alert("Incorrect Admin Password!");
        }

        function resetStudent() {
            let roll = document.getElementById('resetRollNo').value.trim().toUpperCase();
            if(!roll) return alert("Enter a Roll Number.");
            localStorage.removeItem(`exam_${roll}_batch1_start`);
            localStorage.removeItem(`exam_${roll}_batch1_complete`);
            alert(`Access reset successfully for Roll No: ${roll}`);
            document.getElementById('resetRollNo').value = "";
        }
    </script>
</body>
